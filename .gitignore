# ──────────────────────────────────────────
#  RazorHub .gitignore
# ──────────────────────────────────────────

# Local environment & secrets (NEVER commit these)
.env
.ev
.env.local
.env.*.local
frontend/.env.local
backend/.env
render-backup/

# OpenCode & AI Assistant Configs
.opencode/

# ── Python / Django ────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
*.pdb
*.sqlite3-journal
test_*.db

# Virtual environment (active local venv)
# venv/
# backend/venv/

# ── Node / Vite ────────────────────────────
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.vite/
frontend/.vite/

# Build output
build/
*.local

# ── Dev server logs ────────────────────────
logs/
*.log

# ── Audit & Diagnostic Dumps ───────────────
backend/flagged_products.json
backend/image_audit_trail.json
flagged_products.json
image_audit_trail.json

# ── OS & Editor ────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ── Misc ───────────────────────────────────
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
coverage/
.coverage
htmlcov/
.neon
