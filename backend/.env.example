# ==============================================================================
# RazorHub Backend Environment Configuration Template
# Copy this file to `backend/.env` and populate your secrets.
# ==============================================================================

# Database Connection (Neon Serverless Postgres or SQLite)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require&channel_binding=require

# Django Core
SECRET_KEY=django-insecure-your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=*

# Payment Gateways (Razorpay)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Media & Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# Monitoring & Error Tracking (Sentry)
SENTRY_DSN=https://your_sentry_dsn@o0.ingest.sentry.io/0

# ── Multi-Model AI LLM Providers (Activate Any) ─────────────────────────────
# 1. OpenRouter (Multi-model router)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=openrouter/auto

# 2. Groq (Ultra low-latency Llama 3.3)
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 3. Mistral AI
MISTRAL_API_KEY=your_mistral_api_key
MISTRAL_MODEL=mistral-small-latest

# 4. Google Gemini
GEMINI_API_KEY=your_gemini_api_key

# 5. xAI / Grok
GROK_API_KEY=your_grok_key_here
GROK_MODEL=grok-2-latest
