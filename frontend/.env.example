# ==============================================================================
# RazorHub Frontend Environment Configuration Template
# Copy this file to `frontend/.env.local`
# ==============================================================================

# Backend API Base URL (Leave empty in local dev to use Vite proxy /api)
VITE_API_URL=

# Google OAuth 2.0 Client ID (Optional)
VITE_GOOGLE_CLIENT_ID=

# Sentry Frontend Error Monitoring (Optional)
VITE_SENTRY_DSN=
